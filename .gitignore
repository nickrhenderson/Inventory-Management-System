# Executables and build specs (safety net, in case any land at the root)
*.exe
*.spec

# Database files (safety net; runtime DB lives under dev/data which is ignored via dev/)
*.db
*.sqlite
*.sqlite3

# Preconfigured build config files (e.g. Google OAuth client)
configs/

# Local dev environment: build outputs, runtime dev data, and dev utilities
#   dev/build_out/  <-- PyInstaller intermediate work files
#   dev/dist/       <-- final standalone .exe
#   dev/data/       <-- runtime dev database / settings / product images
#   dev/utils/      <-- dev-only scripts (build_exe.py, test_*.py, etc.)
dev/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.log
to-do.txt

# PyInstaller specific
*.manifest

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST